# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development          # development | production | testing
APP_ENV=development

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<db_name>

# ── Seguridad (cambia estas claves en producción) ─────────────────────────────
SECRET_KEY=cambia-esta-clave-en-produccion-minimo-32-caracteres
JWT_SECRET_KEY=cambia-esta-clave-jwt-en-produccion-minimo-32-caracteres

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://<host>:6379/0

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_<tu-service-key>

# ── Correo SMTP (Gmail App Password) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=andresquilichechavez@gmail.com
SMTP_PASSWORD=<tu-password-de-aplicacion-sin-espacios>
SMTP_FROM=andresquilichechavez@gmail.com

# ── Firebase Admin SDK (notificaciones push) ──────────────────────────────────
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json
